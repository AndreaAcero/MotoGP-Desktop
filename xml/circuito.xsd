<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="http://www.uniovi.es" elementFormDefault="qualified" targetNamespace="http://www.uniovi.es" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	
<xs:element name="circuito">
	<xs:complexType>
		<xs:sequence>
			<!--Nombre del circuito-->
			<xs:element name="nombre" type="xs:string"/>

			<!--Longitud total del circuito-->
			<xs:element name="longitud">
			<xs:complexType>
				<xs:simpleContent>
				<xs:extension base="xs:decimal">
					<xs:attribute name="unidades" type="xs:string" use="required"/>
				</xs:extension>
				</xs:simpleContent>
			</xs:complexType>
			</xs:element>

			<!--Anchura de la pista-->
			<xs:element name="anchura">
			<xs:complexType>
				<xs:simpleContent>
				<xs:extension base="xs:decimal">
					<xs:attribute name="unidades" type="xs:string" use="required"/>
				</xs:extension>
				</xs:simpleContent>
			</xs:complexType>
			</xs:element>
			
			<!--Fecha de la carrera-->
			<xs:element name="fecha" type="xs:date"/>
			
			<!--Hora de inicio de la carrera-->
			<xs:element name="hora" type="xs:time"/>
			
			<!--Número de vueltas de la carrera-->	
			<xs:element name="numVueltas">
				<xs:simpleType>
					<xs:restriction base="xs:positiveInteger">
						<xs:minInclusive value="1"/>
						<xs:maxInclusive value="500"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>

			<!--Localidad donde se encuentra el circuito-->
			<xs:element name="localidad" type="xs:string"/>

			<!--País donde se encuentra el circuito-->
			<xs:element name="pais" type="xs:string"/>

			<!--Patrocinador principal del circuito-->
			<xs:element name="patrocinador" type="xs:string"/>

			<!--Referencias del circuito-->
			<xs:element name="referencias">	
				<xs:complexType>
					<xs:sequence>
						<xs:element name="referencia" type="xs:anyURI" minOccurs="3" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>

			<!--Galería de fotos del circuito-->
			<xs:element name="galeriaFotos">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="foto" type="xs:string" minOccurs="1" maxOccurs="5"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>

			<!--Galería de vídeos del circuito-->
			<xs:element name="galeriaVideos">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="video" type="xs:string" minOccurs="1" maxOccurs="3"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>

			<!--Punto de origen del circuito-->
			<xs:element name="puntoOrigen">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="longitud">
							<xs:simpleType>
								<xs:restriction base="xs:decimal">
									<xs:minInclusive value="-180.0"/>
									<xs:maxInclusive value="180.0"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>	
						<xs:element name="latitud">
							<xs:simpleType>
								<xs:restriction base="xs:decimal">
									<xs:minInclusive value="-90.0"/>
									<xs:maxInclusive value="90.0"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="altitud">
							<xs:simpleType>
								<xs:restriction base="xs:decimal">
									<xs:minInclusive value="-500.0"/>
									<xs:maxInclusive value="9000.0"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>					
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<!--Tramos del circuito-->
			<xs:element name="tramos">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="tramo" minOccurs="1" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>

                    <!-- distancia pasa a ser elemento para que cuelgue del tramo -->
                    <xs:element name="distancia">
                      <xs:complexType>
                        <xs:simpleContent>
                          <xs:extension base="xs:decimal">
                            <xs:attribute name="unidades" type="xs:string" use="required"/>
                          </xs:extension>
                        </xs:simpleContent>
                      </xs:complexType>
                    </xs:element>

                    <xs:element name="longitud">
						<xs:complexType>
							<xs:simpleContent>
							<xs:extension base="xs:decimal">
								<xs:attribute name="unidades" type="xs:string" use="required"/>
							</xs:extension>
							</xs:simpleContent>
						</xs:complexType>
					</xs:element>

                    <xs:element name="latitud">
						<xs:complexType>
							<xs:simpleContent>
							<xs:extension base="xs:decimal">
								<xs:attribute name="unidades" type="xs:string" use="required"/>
							</xs:extension>
							</xs:simpleContent>
						</xs:complexType>
					</xs:element>

                    <xs:element name="altitud">
						<xs:complexType>
							<xs:simpleContent>
							<xs:extension base="xs:decimal">
								<xs:attribute name="unidades" type="xs:string" use="required"/>
							</xs:extension>
							</xs:simpleContent>
						</xs:complexType>
					</xs:element>

                  </xs:sequence>

                  <!-- sector sigue como atributo del tramo -->
                  <xs:attribute name="sector" type="xs:positiveInteger" use="required"/>

                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
			
			<!--Vencedor de la carrera-->
			<xs:element name="vencedor">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="nombre" type="xs:string"/>
						<xs:element name="tiempo" type="xs:duration"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>

			<!--Clasificación Mundial-->
			<!-- Clasificación del mundial -->
			<xs:element name="clasificacionMundial">
			<xs:complexType>
				<xs:sequence>
				<xs:element name="piloto" minOccurs="3" maxOccurs="3">
					<xs:complexType>
					<xs:sequence>
						<xs:element name="nombre" type="xs:string"/>
						<xs:element name="puntos">
						<xs:simpleType>
							<xs:restriction base="xs:integer">
							<xs:minInclusive value="0"/>
							<xs:maxInclusive value="500"/>
							</xs:restriction>
						</xs:simpleType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="posicion">
						<xs:simpleType>
						<xs:restriction base="xs:positiveInteger">
							<xs:minInclusive value="1"/>
							<xs:maxInclusive value="3"/>
						</xs:restriction>
						</xs:simpleType>
					</xs:attribute>
					</xs:complexType>
				</xs:element>
				</xs:sequence>
			</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:element>
</xs:schema>